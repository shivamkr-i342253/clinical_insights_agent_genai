# ── Clinical Insights Agent – Environment Variables ────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required: Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini-2024-07-18
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# Optional: Number of critique review cycles (default 2)
MAX_REVIEWS=2

# Optional: SQLite database path for checkpointer
SQLITE_DB_PATH=clinical_insights.db
